{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cv-online",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-22",
  // Editor UI files. Every request goes through the Worker first, so
  // /admin assets are only served after authentication (ADR-0003).
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Dedicated bucket: this Worker has no access to any other bucket (ADR-0002).
  "r2_buckets": [
    { "binding": "CV_BUCKET", "bucket_name": "cv-online" }
  ],
  "observability": { "enabled": true }
  // Secrets (never in this file): ADMIN_USER, ADMIN_PASSWORD.
  // Set them with `npx wrangler secret put <NAME>`; for local dev use .dev.vars.
}
