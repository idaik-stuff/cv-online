{
  "version": 1,
  "checks": [
    {
      "id": "docs",
      "kind": "framework",
      "argv": [
        "{python}",
        "scripts/check-docs"
      ],
      "timeout_seconds": 30
    },
    {
      "id": "adapters",
      "kind": "framework",
      "argv": [
        "{python}",
        ".agents/tools/sync_adapters.py",
        "--check"
      ],
      "timeout_seconds": 30
    },
    {
      "id": "adapter-tests",
      "kind": "framework",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        ".agents/tools",
        "-p",
        "test_*.py",
        "-v"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "automation-tests",
      "kind": "framework",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts/tests",
        "-p",
        "test_*.py",
        "-v"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "typecheck",
      "kind": "product",
      "argv": [
        "node",
        "node_modules/typescript/bin/tsc",
        "--noEmit"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "worker-tests",
      "kind": "product",
      "argv": [
        "node",
        "node_modules/vitest/vitest.mjs",
        "run",
        "--silent"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "product-install",
      "kind": "product",
      "argv": [
        "{python}",
        "-c",
        "import shutil, subprocess, sys\nnode, npm = shutil.which('node'), shutil.which('npm')\nif not node or not npm:\n    sys.exit('product-install: node and npm must be on PATH')\nsubprocess.run([node, '--version'], check=True)\nsubprocess.run([npm, '--version'], check=True)\nsys.exit(subprocess.call([npm, 'ci', '--no-audit', '--no-fund']))\n"
      ],
      "timeout_seconds": 600
    }
  ],
  "profiles": {
    "framework": {
      "focused": [
        "docs",
        "adapters"
      ],
      "standard": [
        "adapter-tests",
        "automation-tests"
      ],
      "broad": []
    },
    "product": {
      "focused": [
        "product-install",
        "worker-tests"
      ],
      "standard": [
        "typecheck"
      ],
      "broad": []
    }
  }
}
